{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "root": true,
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!research/imported",
      "!experiments/02-host-socket-attribution/evidence/relay-run-r3",
      "!.worktrees",
      "!**/.venv",
      "!!**/node_modules",
      "!!docs/.astro",
      "!!docs/dist"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": { "maxAllowedComplexity": 15 }
        },
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": { "maxLines": 60 }
        },
        "useMaxParams": {
          "level": "error",
          "options": { "max": 5 }
        }
      }
    }
  }
}
